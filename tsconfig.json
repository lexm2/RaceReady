{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ESNext",
    "module": "ESNext",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "types": ["vite/client"],
    "skipLibCheck": true,
    "strict": true,
    "allowImportingTsExtensions": true
  }
  // Path aliases and include/exclude come from .svelte-kit/tsconfig.json.
  // Don't override `include` here or ambient.d.ts (which provides $app/*
  // module types) drops out of the program and svelte-check breaks.
}
